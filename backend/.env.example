# NEXUS AI Backend Environment Configuration
PROJECT_NAME="NEXUS AI Backend"
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Provider selection: mock (safe default), ollama, or openai_compatible
DEFAULT_PROVIDER=mock

# Optional local Ollama provider (NEXUS does not require Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=60.0

# Optional OpenAI-compatible provider; never commit real credentials.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_TIMEOUT_SECONDS=45.0

# Authentication (generate independent random secrets; never commit real values)
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_BOOTSTRAP_SECRET=
ACCESS_TOKEN_TTL_MINUTES=20

# Optional n8n base URL. Workflows fail closed if this is unset.
# Example local: http://127.0.0.1:5678
# Example remote: https://automation.example.com
N8N_WEBHOOK_URL=
